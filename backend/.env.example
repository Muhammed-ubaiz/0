# Copy to .env. Never commit .env or the service account key.
PORT=5000
FIREBASE_PROJECT_ID=idealpack-store
# Path to the key from Firebase console > Project settings > Service accounts.
# Without it, orders and enquiries are held in memory and lost on restart.
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# Comma-separated, verified emails allowed to view orders in /admin.
ADMIN_EMAILS=
